{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile holding configuration and settings",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "currency": { "type": "string" },
        "monthlyBudget": { "type": "number" }
      },
      "required": ["uid"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Financial transaction record (income or expense)",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "type": { "type": "string", "enum": ["income", "expense"] },
        "amount": { "type": "number" },
        "category": { "type": "string" },
        "date": { "type": "string" },
        "note": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["userId", "type", "amount", "category", "date"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Stores user settings and profile data"
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "Stores individual income and expense transactions for each user"
    }
  }
}
